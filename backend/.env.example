PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL URL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/social_network?schema=public"

# JWT Security Secrets
JWT_ACCESS_SECRET="super-secret-access-token-key-change-in-production-12345"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-production-67890"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Real-time WebRTC STUN/TURN servers
STUN_SERVER="stun:stun.l.google.com:19302"
TURN_SERVER=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# Media Uploads (Cloudinary or AWS S3)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
